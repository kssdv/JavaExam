package aRank;

import java.util.Scanner;

public class exam52 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a = sc.nextInt();
		int b = sc.nextInt();
		int res = -10;
		if(a > b) {
			res = 1;
		}else if(a == b) {
			res = 0;
		}else if(a < b) {
			res = -1;
		}
		
		System.out.println(res);
	}

}
