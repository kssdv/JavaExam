package aRank;
import java.util.LinkedList;
import java.util.Queue;
/*
入力
3 3 A
A..
...
..B

出力
8
 */
import java.util.Scanner;

public class exam59 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		Queue<int[]> queue = new LinkedList<>();
		int h = sc.nextInt();
		int w = sc.nextInt();
		// 先行のプレイヤー
		char firstPlayer = sc.next().charAt(0);
		int[] startPointA = new int[2];
		int[] startPointB = new int[2];
		char[][] grid = new char[h][w];
		
		for(int i=0; i<h; i++) {
			String line = sc.next();
			for(int j=0; j<w; j++) {
				grid[i][j] = line.charAt(j);
				if(grid[i][j] == 'A') {
//					queue.add(new int[] {i, j});
					startPointA = new int[] {i, j};
				}else if(grid[i][j] == 'B') {
					startPointB = new int[] {i, j};
				}
			}
		}
		
		if(firstPlayer == 'A') {
			queue.add(startPointA);
			queue.add(startPointB);
		}else {
			queue.add(startPointB);
			queue.add(startPointA);
		}
		
		int[] dy = {-1, 1, 0, 0};
		int[] dx = {0, 0, -1, 1};
		
		while(!queue.isEmpty()) {
			int[] current = queue.poll();
			int currentY = current[0];
			int currentX = current[1];
			
			for(int i=0; i<4; i++) {
				int nextY = currentY + dy[i];
				int nextX = currentX + dx[i];
				
				if(nextY < 0 || nextY >= h || nextX < 0 || nextX >= w) {
					continue;
				}
				
				if(grid[nextY][nextX] == '.') {
					queue.add(new int[] {nextY, nextX});
					// 以前'A'だったら'A'を次のマスに
					grid[nextY][nextX] = grid[currentY][currentX];
				}
				
			}
		}
		int countA = 0;
		int countB = 0;
		for(int i=0; i<grid.length; i++) {
			for(int j=0; j<grid[0].length; j++) {
				if(grid[i][j] == 'A') {
					countA++;
				}else if(grid[i][j] == 'B'){
					countB++;
				}
			}
		}
		System.out.println(countA + " " + countB);
		System.out.println(countA > countB ? 'A' : 'B');
		
	}
}
