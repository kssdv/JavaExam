import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.StringTokenizer;

public class exam82 {

	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		int n = Integer.parseInt(st.nextToken());
		int m = Integer.parseInt(st.nextToken());
		List<Integer> nodes = new ArrayList<>();
		HashMap<Integer, List<Integer>> dictionary = new HashMap<>();
		for(int i=0; i<m; i++) {
			st = new StringTokenizer(br.readLine());
			int a = Integer.parseInt(st.nextToken()) - 1;
			int b = Integer.parseInt(st.nextToken()) - 1;
			
			int t1 = Math.min(a, b);
			int t2 = Math.max(a, b);
			
			if(!dictionary.containsKey(t1)) {
				List<Integer> tlst = new ArrayList<>();
				tlst.add(t2);
				dictionary.put(t1, tlst);
			}else if(!dictionary.get(t1).contains(t2)) {
				dictionary.get(t1).add(t2);
			}
			
			if(!nodes.contains(t1)) {
				nodes.add(t1);
			}
			if(!nodes.contains(t2)) {
				nodes.add(t2);
			}
		}
		
		List<Integer> keyList = new ArrayList<>(dictionary.keySet());
		Collections.sort(keyList);
		
		Collections.sort(nodes);
		for(int i: nodes) {
			System.out.println(i);
		}
		
	}

}
