	private static void pringGrid(char[][] grid) {
		for(int i=0; i<grid.length; i++) {
			for(int j=0; j<grid[0].length; j++) {
				System.out.print(grid[i][j]);
			}
			System.out.println();
		}
	}
	
	// 上下左右を'*'に変えるメソッド
	private static void UPLR(char[][] grid, int[] position) {
		// 上下左右
		int[][] udlr = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
		for(int i=0; i<udlr.length; i++) {
			int[] tmp = new int[] {position[0] + udlr[i][0], position[1] + udlr[i][1]};
			if(isInside(grid, tmp)) {
				grid[tmp[0]][tmp[1]] = '*';
			}
		}
	}
	
	private static boolean isInside(char[][] grid, int[] position) {
		if(position[0] >= grid.length || position[0] < 0) return false;
		if(position[1] >= grid[0].length || position[1] < 0) return false;		
		return true;
	}
