package aRank;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Dictionary;
import java.util.Hashtable;
import java.util.List;
import java.util.StringTokenizer;

public class exam80 {

	public static void main(String[] args) throws IOException{
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		int n = Integer.parseInt(st.nextToken());
		if(n == 1) {
			System.out.println();
			return;
		}
		int minIdx = Integer.MAX_VALUE;
		int min = Integer.MAX_VALUE;
		int[][] g = new int[n-1][2];
		List<Integer> tlst = new ArrayList<>();
		List<Integer> lst = new ArrayList<>();
		Dictionary<Integer, Integer> dictionary = new Hashtable<>();
		
		
		for(int i=0; i<n-1; i++) {
			st = new StringTokenizer(br.readLine());
			int a = Integer.parseInt(st.nextToken()) - 1;
			int b = Integer.parseInt(st.nextToken()) - 1;
			
			if(min > Math.min(a, b)) {
				min = Math.min(a, b);
				minIdx = i;
			}
			g[i] = new int[] {a, b};
			
			if (!tlst.contains(a)) tlst.add(a);
			if (!tlst.contains(b)) tlst.add(b);
		}
		
		Collections.sort(tlst);
		
		for(int i=0; i<n; i++) {
			st = new StringTokenizer(br.readLine());
			int a = Integer.parseInt(st.nextToken());
			dictionary.put(tlst.get(i), a);
		}
		
		lst.add(Math.min(g[minIdx][0], g[minIdx][1]));
	}

}
