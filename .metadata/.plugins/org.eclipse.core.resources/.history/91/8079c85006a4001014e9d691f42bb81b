package aRank;

import java.util.Scanner;

public class exam41 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int h = sc.nextInt();
		int w = sc.nextInt();
		char[][] grid = new char[h][w];
		int[] idx = new int[2];
		
		for(int i=0; i<h; i++) {
			char[] tmp = sc.next().toCharArray();
			for(int j=0; j<tmp.length; j++) {
				if(tmp[j] == '*') idx = new int[] {i, j};
			}
			grid[i] = tmp;
		}
		
	}
}
