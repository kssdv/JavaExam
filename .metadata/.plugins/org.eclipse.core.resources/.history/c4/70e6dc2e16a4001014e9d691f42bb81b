package aRank;

import java.util.Scanner;

public class exam43 {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int h = sc.nextInt();
		int w = sc.nextInt();
		
		char[][] grid = new char[h][w];
		int startRow = -1, startCol = -1;
		
		for(int i=0; i<h; i++) {
			String line = sc.next();
			for(int j=0; j<w; j++) {
				grid[i][j] = line.charAt(j);
				// 始発点の'*'探す
				if(grid[i][j] == '*') {
					startRow = i;
					startCol = j;
				}
			}
		}
		sc.close();
		
		// Queue生成
		Queue<int[]> queue = new LinkedList<>();
	}

}
