package aRank;

import java.util.Scanner;

public class exam48 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int[] lst = new int[24];
		int n = sc.nextInt();
		
		for(int i=0; i<n; i++) {
			int t1 = sc.nextInt();
			int t2 = sc.nextInt();
			
			if(t1 < t2) {
				for(int j=t1; j<t2; j++) {
					lst[j]++;
				}
			}
		}
	}
}
