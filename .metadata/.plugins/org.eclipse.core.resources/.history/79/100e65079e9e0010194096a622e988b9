package aRank;

import java.util.Scanner;

public class exam26 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int h = sc.nextInt();
		int w = sc.nextInt();
		char[][] grid = new char[h][w];
		
		for(int i=0; i<h; i++) {
			String tmp = sc.next();
			grid[i] = tmp.toCharArray();
		}
		
		if(w >= 2) {
			for(int i=0; i<h; i++) {
				for(int j=0; j<w; j++) {
//					if(grid[i][j] == '#' && j == 0) {
					if(j == 0) { // 左上端
						if(grid[i][j+1] == '#') {
							System.out.println(i+" "+j);
						}
					}else if(j == w - 1) { // 右上端
						if(grid[i][j-1] == '#') {
							System.out.println(i+" "+j);
						}
					}else {
						if(grid[i][j+1] == '#' && grid[i][j-1] == '#') {
							System.out.println(i+" "+j);
						}
					}
				}
			}
		}
		
	}

}
