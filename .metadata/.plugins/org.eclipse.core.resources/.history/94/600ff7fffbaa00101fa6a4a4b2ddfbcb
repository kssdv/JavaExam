package aRank;

import java.util.Scanner;

public class exam60 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int h = sc.nextInt();
		int w = sc.nextInt();
		char[][] grid = new char[h][w];
		int[] startPoint = new int[2];
		
		for(int i=0; i<h; i++) {
			String line = sc.next();
			for(int j=0; j<w; j++) {
				grid[i][j] = line.charAt(j);
				if(grid[i][j] == '!') {
					startPoint = new int[] {i, j};
				}
			}
		}
		
		
	}

}
