package aRank;

import java.util.ArrayList;
import java.util.LinkedList;
import java.util.List;
import java.util.Queue;
import java.util.Scanner;

public class exam61 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		Queue<int[]> queue = new LinkedList<>();
		int h = sc.nextInt();
		int w = sc.nextInt();
		int n = sc.nextInt();
		char[][] grid = new char[h][w];
		int[][] startPoints = new int[n][2];
//		int[] startPoint = new int[2];
		
		for(int i=0; i<h; i++) {
			String line = sc.next();
			for(int j=0; j<w; j++) {
				grid[i][j] = line.charAt(j);
//				if(grid[i][j] == '!') {
//					startPoint = new int[] {i, j};
//				}
			}
		}
		
		for(int i=0; i<n; i++) {
			startPoints[i][0] = sc.nextInt();
			startPoints[i][1] = sc.nextInt();
		}
		
		int[] dy = {-1, -1, -1, 0, 1, 1, 1, 0};
		int[] dx = {-1, 0, 1, 1, 1, 0, -1, -1};
		
		for(int[] startPoint : startPoints) {
			grid[startPoint[0]][startPoint[1]] = '*';
			
			for(int i=0; i<8; i++) {
				List<int[]> stones = new ArrayList<>();
				int[] current = startPoint.clone();
				boolean flag = false;
				int cy = current[0];
				int cx = current[1];
				
				while(!(cy < 0 || cy >= h || cx < 0 || cx >= w)) {
					stones.add(new int[] {cy, cx});
					int ny = cy + dy[i];
					int nx = cx + dx[i];
					
					cy = cy + dy[i];
					cx = cx + dx[i];
					
					if(ny < 0 || ny >= h || nx < 0 || nx >= w || grid[ny][nx] == '#') {
						break;
					}
					
					if(grid[ny][nx] == '*') {
						flag = true;
						break;
					}
				}
				if(flag) {
					for(int[] ilst : stones) {
						grid[ilst[0]][ilst[1]] = '*';
					}
				}
				
			}
		}
		
		printGrid(grid);
	}
	private static void printGrid(char[][] grid) {
		for(int i=0; i<grid.length; i++) {
			for(int j=0; j<grid[0].length; j++) {
				System.out.print(grid[i][j]);
			}
			System.out.println();
		}
	}
}
