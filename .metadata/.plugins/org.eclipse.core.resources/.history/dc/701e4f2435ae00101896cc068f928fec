/*
input
1 10
9
output
-1

intput
10 27
16 9 2 6 18 3 1 3 6 8

output
3
 */
import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

public class exam69 {

    public static void main(String[] args) throws IOException {
        // 빠른 입력을 위해 BufferedReader 사용
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        
        // 1. 첫 번째 줄 입력 (N과 M)
        StringTokenizer st = new StringTokenizer(br.readLine());
        int n = Integer.parseInt(st.nextToken());
        long m = Long.parseLong(st.nextToken()); // M의 값이 클 수 있으므로 long으로 받는 것이 안전할 수 있습니다.

        // 2. 두 번째 줄 입력 (수열 A)
        int[] a = new int[n];
        st = new StringTokenizer(br.readLine());
        for (int i = 0; i < n; i++) {
            a[i] = Integer.parseInt(st.nextToken());
        }

        // 3. 슬라이딩 윈도우 알고리즘 적용
        int start = 0; // 윈도우의 시작점
        long currentSum = 0; // 현재 윈도우의 합
        int maxLength = 0; // 1. add maxLength

        // end 포인터를 0부터 n-1까지 이동 (윈도우 확장)
        for (int end = 0; end < n; end++) {
            currentSum += a[end];

            // 2. while 조건 변경
            while (currentSum > m) {
                // 윈도우를 왼쪽에서 한 칸 줄인다.
                currentSum -= a[start];
                start++;
            }
            // 3. 정답 갱신 위치 변경
            maxLength = Math.max(maxLength, end - start + 1);
        }

        // 4. 최종 출력 방식 변경 (결과 출력)
        System.out.println(maxLength);
        
    }
}