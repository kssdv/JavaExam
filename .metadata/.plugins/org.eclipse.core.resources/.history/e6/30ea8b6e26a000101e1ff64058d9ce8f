package aRank;

import java.util.Scanner;

public class exam30 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int x = sc.nextInt();
		int y = sc.nextInt();
		int n = sc.nextInt();
		// x, y
		int[][] d = {{1,0}, {0,1}, {-1,0}, {0,-1}};
		int idx = 0;
		int move = 1;
		int cnt = 0;
		
		while(cnt < n) {
			for(int i=0; i<2; i++) {
				for(int j=0; j<move; j++) {
					x += d[idx][0];
					y += d[idx][1];
					cnt++;
					if(cnt >= n) break;
				}
//				if(cnt >= n) break;
				idx++;
				idx = idx % 3;
			}
			move++;
		}
		System.out.println(x+" "+y);
	}

}
