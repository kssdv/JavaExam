package aRank;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

public class exam74 {

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());
        int n = Integer.parseInt(st.nextToken());
        long k = Long.parseLong(st.nextToken());
        int[] a = new int[n];
        st = new StringTokenizer(br.readLine());
        
        // 배열에 0이 있는지 확인하기 위한 플래그
        boolean hasZero = false;
        for (int i = 0; i < n; i++) {
            a[i] = Integer.parseInt(st.nextToken());
            if (a[i] == 0) {
                hasZero = true;
            }
        }

        // 만약 k가 0이라면, 0을 포함하는 부분수열(길이 1)이 최단 길이.
        if (k == 0) {
            System.out.println(hasZero ? 1 : 0);
            return;
        }
        
        // 만약 k가 1이고 배열에 0이 없다면, 어떤 원소든 길이가 1인 부분수열이 답.
        // 하지만 아래 로직에서 자연스럽게 처리되므로 별도 코드는 필요 없음.

        int start = 0;
        long product = 1; // 1. long 타입으로 변경
        int minLength = Integer.MAX_VALUE;

        for (int end = 0; end < n; end++) {
            // 0을 만나면 윈도우를 리셋. 0 다음부터 다시 시작.
            if (a[end] == 0) {
                start = end + 1;
                product = 1;
                continue;
            }

            // 윈도우 확장
            product *= a[end];

            // 윈도우 축소
            while (product >= k) {
                // 2. 최단 길이 업데이트 (길이 계산: end - start + 1)
                minLength = Math.min(minLength, end - start + 1);

                // 3. 윈도우의 왼쪽을 한 칸 줄임 (효율적인 방법)
                product /= a[start];
                start++;
            }
        }

        // 결과 출력
        if (minLength == Integer.MAX_VALUE) {
            System.out.println(0);
        } else {
            System.out.println(minLength);
        }
    }
}